        "tile_stride_y": [
          "INT",
          {
            "default": 128,
            "min": 32,
            "max": 2040,
            "step": 8,
            "tooltip": "Tile stride height in pixels. Smaller values use less VRAM but will introduce more seams."
          }
        ]
      },
      "optional": {
        "normalization": [
          [
            "default",
